# FinSight AI — Environment Configuration Example

# Environment mode: development / production
ENVIRONMENT=production

# Database URL: default is SQLite fallback; supports PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@hostname:5432/finsight

# OpenAI API Key (Optional: system automatically uses deterministic intelligence engine if omitted)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
